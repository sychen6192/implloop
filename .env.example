# implloop 設定範例。複製為 .env（放在工具 clone 目錄）；已存在的環境變數不會被覆蓋。

# --- 模型 ---
# provider/model 格式；空 = 用 agent .md 的 model 欄位
#IL_MODEL=ollama/qwen3-coder            # planner + writer 一次設定
#IL_PLANNER_MODEL=
#IL_WRITER_MODEL=
#IL_REVIEWER_MODEL=                     # 建議用不同 model family（cross-model 審查）

# --- 迭代與停損 ---
#IL_MAX_SESSIONS=20        # 整個 run 的 agent session 總預算
#IL_STEP_RETRIES=3         # 每步驟修復嘗試上限
#IL_STUCK_REPEATS=2        # 同一失敗簽章連續重複幾次即停損
#IL_MAX_STEPS=8            # 計畫步驟上限
#IL_PLAN_RETRIES=2         # planner 產不出合法計畫的重試次數
#IL_REVIEW_ROUNDS=2        # review 回合上限（修正回合 = 值 − 1）

# --- Phase 開關 ---
#IL_TEST_FIRST=1           # 0 = 跳過 test-first（不建議：防作弊主力）
#IL_SKIP_REVIEW=1          # 1 = 跳過 review gate
#IL_SKIP_BASELINE=1        # 1 = 跳過起點 baseline 測試（不建議）
#IL_REVIEWER_MUST_READ=1   # 0 = 允許 reviewer 沒讀檔就給判決（不建議）

# --- Gate ---
#IL_BUILD_CMD=             # 空 = 自動偵測（maven/gradle/npm/pytest）
#IL_TEST_CMD=
#IL_GATE_TIMEOUT_MS=900000 # 單次 build/test 逾時（15 分鐘）
#IL_PROTECT=               # 額外保護 glob，逗號分隔，例：src/generated/**,db/migrations/**

# --- Git ---
#IL_BRANCH_PREFIX=implloop/

# --- Runner ---
#IL_RUNNER=opencode
#IL_AGENT_TIMEOUT_MS=1500000  # 單 session 逾時（25 分鐘；dense 27B 需要餘裕）
#IL_OPENCODE_BIN=opencode
#IL_OPENCODE_JSON=1        # 0 = 不用 --format json（舊版 opencode 相容，失去即時進度）
#IL_OC_SKIP_PERMS=1        # 1 = writer 加 --dangerously-skip-permissions（最後手段）

# --- 其他 ---
#IL_QUIET=1                # 1 = 關閉 verbose 進度
#IL_SKIP_GUARD=1           # 1 = 跳過 agent 權限 guard（不建議）

# artifacts 落點覆蓋（共用或唯讀安裝時使用；預設寫在工具 clone 的 runs/ 下）
#IL_RUNS_DIR=
