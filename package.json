{
  "name": "implloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts",
    "check": "tsc --noEmit && tsx scripts/selftest.ts",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "description": "Autonomous implementation loop: plan, test-first, implement step-by-step, review — with exit-code-level anti-cheating gates",
  "license": "MIT"
}
